# Demo never sends real email or calls payment/redemption providers. Local access only.
APP_MODE=demo
# Production: APP_URL=https://getcodex.plus
APP_URL=http://localhost:3000
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Only first-party funnel statistics are enabled. Third-party analytics scripts
# must not run alongside Session, card inventory, or administrator inputs.
DATABASE_URL=postgresql://getgpt@127.0.0.1:55439/getgpt
ADMIN_EMAIL=admin@example.com
# Required in live mode. Generate two DIFFERENT values with: openssl rand -hex 32
# Back up both keys securely. Changing a key requires a data/session migration.
ENCRYPTION_KEY=
BETTER_AUTH_SECRET=
# Only used by bun run admin:bootstrap. File permissions should be 0600.
BOOTSTRAP_PASSWORD_FILE=
# Enable only behind a trusted reverse proxy that overwrites X-Real-IP.
TRUST_PROXY=false
# Payment, AICDK, SMTP and Resend credentials are configured in /admin, not env vars.
