# Demo never sends real email or calls payment/redemption providers. Local access only.
APP_MODE=demo
# Production: APP_URL is your downstream storefront's HTTPS origin, not the supplier URL.
APP_URL=http://localhost:3000
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Optional GA4 Measurement ID (G-XXXXXXXXXX). Empty/invalid disables GA.
# Set at build AND runtime, then rebuild. Leave empty in demo/test environments.
# Turn OFF Enhanced measurement in the GA web stream before enabling.
# GTM is not used. See docs/growth-and-seo.md for collection and verification.
NEXT_PUBLIC_GA_ID=
DATABASE_URL=postgresql://getgpt@127.0.0.1:55439/getgpt
ADMIN_EMAIL=admin@example.com
# Required in live mode. Generate two DIFFERENT values with: openssl rand -hex 32
# Back up these and the OPAQUE setup securely. Do not replace existing keys.
ENCRYPTION_KEY=
BETTER_AUTH_SECRET=
# Required in live mode. Generate with: bunx @serenity-kit/opaque@0.9.0 create-server-setup
# Back up this independently from the database. Never regenerate it on restart.
# Local demo persists its generated setup in .data/opaque.key (0600).
OPAQUE_SERVER_KEY=
# Alternatively, read the setup from a protected 0600 file.
OPAQUE_SERVER_KEY_FILE=
# Only used by bun run admin:bootstrap. File permissions should be 0600.
BOOTSTRAP_PASSWORD_FILE=
# The gateway resolves the proxy chain and overwrites X-Forwarded-For with one client IP.
# Authentication, risk checks and payments share Better Auth's parser for that address.
AICDK_WEBHOOK_ENABLED=false
AICDK_WEBHOOK_SECRET=
# The optional webhook only wakes polling. Configure Dujiao-Next and AICDK API credentials in /admin.

# Docker production settings (see docs/deployment.md).
# Set APP_MODE=live and APP_URL=https://your-store-domain before starting production.
# With compose.prod.yaml, REMOVE the local DATABASE_URL above to use the bundled database.
# A hexadecimal password avoids URL-encoding issues: openssl rand -hex 32
# POSTGRES_PASSWORD=
# Pin an existing release tag or digest after the first image is published.
# GETCODEX_IMAGE=ghcr.io/getcodex-plus/store:<version>
# BIND_ADDRESS=127.0.0.1
# PORT=3000
# Optional existing Traefik gateway (compose.traefik.yaml):
# APP_DOMAIN=
# TRAEFIK_NETWORK=traefik
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=letsencrypt
