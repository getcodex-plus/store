{
  "name": "getgpt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --bun next dev --hostname 127.0.0.1",
    "build": "bun --bun next build",
    "start": "bun --bun next start --hostname 127.0.0.1",
    "worker": "bun --env-file=.env src/server/worker.ts",
    "db:migrate": "bun --env-file=.env scripts/migrate.ts",
    "admin:bootstrap": "bun --env-file=.env scripts/bootstrap-admin.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@ant-design/nextjs-registry": "1.3.0",
    "@better-auth/passkey": "1.7.22",
    "@marsidev/react-turnstile": "1.6.3",
    "@next/third-parties": "16.4.6",
    "antd": "6.7.0",
    "better-auth": "1.7.22",
    "next": "16.4.6",
    "nodemailer": "10.5.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.38.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "otpauth": "9.6.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
